{
  "name": "ms-mailer-templates-v26",
  "description": "RadioFX v26 email templates for the mailer microservice. Own copy of the templates package, no longer tracking the upstream makeomatic/ms-mailer-templates project. Consumed as a git dependency (build/ and lib/ are committed, not published to npm).",
  "version": "1.0.0",
  "main": "./lib/index.js",
  "scripts": {
    "build": "gulp production",
    "compile": "babel ./src -d ./lib",
    "prepublish": "npm run build && npm run compile",
    "lint": "eslint ./src",
    "test": "npm run lint && npm run build && NODE_ENV=test mocha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RadioFX/ms-mailer-templates-v26.git"
  },
  "license": "MIT",
  "dependencies": {
    "bluebird": "^3.5.1",
    "common-errors": "^1.0.5",
    "handlebars": "^4.1.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.0.0",
    "@babel/core": "^7.4.0",
    "@babel/plugin-transform-class-properties": "^7.4.0",
    "@babel/plugin-transform-object-rest-spread": "^7.4.0",
    "@babel/plugin-transform-strict-mode": "^7.2.0",
    "@babel/preset-env": "^7.4.0",
    "babel-eslint": "^10.0.1",
    "chai": "^4.1.2",
    "datauri": "^1.1.0",
    "del": "^4.0.0",
    "eslint": "5.15.3",
    "eslint-config-makeomatic": "^3.0.0",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-mocha": "^5.0.0",
    "gulp": "^4.0.0",
    "gulp-cli": "^2.0.1",
    "gulp-htmlmin": "^5.0.1",
    "gulp-imagemin": "^5.0.3",
    "gulp-inline-css": "^3.3.0",
    "gulp-inline-source": "^4.0.0",
    "gulp-preprocess": "^3.0.2",
    "imagemin-pngcrush": "^6.0.0",
    "mocha": "^6.0.2"
  }
}
